# ============================================================
# VERCEL ENVIRONMENT VARIABLES — add each one separately
# Vercel → mittiganesha → Settings → Environment Variables
# Enable for: Production + Preview
# ============================================================

# Shopify storefront (website reads products)
SHOPIFY_STORE_DOMAIN=0vfr3h-bn.myshopify.com
SHOPIFY_STOREFRONT_ACCESS_TOKEN=78d729d0f670ca44b4c865b056bdfe0c

# Shopify Admin (REQUIRED for orders to appear in Shopify Admin → Orders)
# From dev.shopify.com → mittiganesha app → Settings → Credentials
SHOPIFY_CLIENT_ID=fa0ad313917d9701c6454577e9fc7c7a
SHOPIFY_CLIENT_SECRET=your-client-secret-from-dev-dashboard

# Login / guest checkout sessions (generate: openssl rand -base64 32)
SESSION_SECRET=your-random-32-char-secret-here

# Razorpay payments (dashboard.razorpay.com → Settings → API Keys)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=your-razorpay-secret-here

# ============================================================
# ALSO REQUIRED IN dev.shopify.com (not env vars):
# Versions → Scopes must include:
#   write_products,read_products,write_files,read_files,
#   write_inventory,read_inventory,
#   write_draft_orders,read_draft_orders,write_orders,read_orders
# Then click Release and redeploy Vercel.
# ============================================================
