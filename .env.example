# Copy to Vercel → Settings → Environment Variables
# Add each variable separately — do NOT paste this whole file into one field.

SHOPIFY_STORE_DOMAIN=0vfr3h-bn.myshopify.com
SHOPIFY_STOREFRONT_ACCESS_TOKEN=your-public-headless-token-here

# Session encryption (generate: openssl rand -base64 32)
SESSION_SECRET=your-random-32-char-secret-here

# Razorpay — get from dashboard.razorpay.com → Settings → API Keys
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=your-razorpay-secret-here

# Optional — required for product uploads AND syncing Razorpay orders to Shopify
SHOPIFY_CLIENT_ID=your-dev-app-client-id
SHOPIFY_CLIENT_SECRET=your-dev-app-client-secret
